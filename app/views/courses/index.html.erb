<% content_for :page_title, "Môn học" %>
<% content_for :breadcrumb do %>
  <li class="breadcrumb-item active">Danh sách môn học</li>
<% end %>

<div class="card card-warning card-outline">
  <div class="card-header">
    <h3 class="card-title">
      <i class="fas fa-book mr-2"></i>
      Danh sách môn học
      <span class="badge badge-warning ml-2"><%= @courses.size %></span>
    </h3>
    <div class="card-tools">
      <%= link_to new_course_path, class: "btn btn-warning btn-sm" do %>
        <i class="fas fa-plus mr-1"></i> Thêm môn học
      <% end %>
    </div>
  </div>

  <div class="card-body p-0">
    <% if @courses.empty? %>
      <div class="p-4 text-center text-muted">
        <i class="fas fa-inbox fa-3x mb-3"></i>
        <p>Chưa có môn học nào.</p>
      </div>
    <% else %>
      <table class="table table-hover table-striped mb-0">
        <thead class="thead-light">
          <tr>
            <th>Mã môn</th>
            <th>Tên môn học</th>
            <th class="text-center">Tín chỉ</th>
            <th class="text-center">SV đăng ký</th>
            <th>Mô tả</th>
            <th class="text-center">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% @courses.each do |course| %>
            <tr>
              <td><span class="badge badge-warning"><%= course.code %></span></td>
              <td><strong><%= course.name %></strong></td>
              <td class="text-center">
                <span class="badge badge-secondary"><%= course.credits || "—" %></span>
              </td>
              <td class="text-center"><%= course.enrollments.size %></td>
              <td><small class="text-muted"><%= truncate(course.description, length: 50) %></small></td>
              <td class="text-center">
                <%= link_to course, class: "btn btn-xs btn-info mr-1" do %>
                  <i class="fas fa-eye"></i>
                <% end %>
                <%= link_to edit_course_path(course), class: "btn btn-xs btn-warning mr-1" do %>
                  <i class="fas fa-edit"></i>
                <% end %>
                <%= link_to course,
                            data: { turbo_method: :delete,
                                    turbo_confirm: "Xóa môn #{course.name}?" },
                            class: "btn btn-xs btn-danger" do %>
                  <i class="fas fa-trash"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
