<h1>Chi tiết Lớp học</h1>

<dl>
  <dt>ID:</dt>
  <dd><%= @classroom.id %></dd>

  <dt>Tên lớp:</dt>
  <dd><%= @classroom.name %></dd>

  <dt>Năm học:</dt>
  <dd><%= @classroom.academic_year.presence || "(chưa có)" %></dd>

  <dt>Mô tả:</dt>
  <dd><%= @classroom.description.presence || "(chưa có)" %></dd>

  <dt>Ngày tạo:</dt>
  <dd><%= @classroom.created_at.strftime("%d/%m/%Y %H:%M") %></dd>
</dl>

<hr>

<h2>Sinh viên trong lớp (<%= @students.count %>)</h2>

<% if @students.empty? %>
  <p><em>Lớp này chưa có sinh viên nào.</em></p>
<% else %>
  <table border="1" cellpadding="8">
    <thead>
      <tr>
        <th>ID</th>
        <th>Họ tên</th>
        <th>Email</th>
        <th>Điện thoại</th>
        <th>Thao tác</th>
      </tr>
    </thead>
    <tbody>
      <% @students.each do |student| %>
        <tr>
          <td><%= student.id %></td>
          <td><%= student.name %></td>
          <td><%= student.email %></td>
          <td><%= student.phone %></td>
          <td>
            <%= link_to "Xem", student %>
            |
            <%# Xóa khỏi lớp: set classroom_id = nil %>
            <%= link_to "Xóa khỏi lớp",
                remove_student_classroom_path(@classroom, student_id: student.id),
                data: { turbo_method: :delete,
                        turbo_confirm: "Xóa #{student.name} khỏi lớp #{@classroom.name}?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<hr>

<%# Form gán sinh viên chưa có lớp vào lớp này %>
<h3>Thêm sinh viên vào lớp</h3>

<% if @unassigned_students.empty? %>
  <p><em>Không có sinh viên nào chưa được xếp lớp.</em></p>
<% else %>
  <%= form_with url: assign_student_classroom_path(@classroom), method: :patch do |form| %>
    <%= form.select :student_id,
          @unassigned_students.map { |s| [s.name, s.id] },
          { include_blank: "-- Chọn sinh viên --" } %>
    <%= form.submit "Thêm vào lớp" %>
  <% end %>
<% end %>

<br>
<%= link_to "✏️ Chỉnh sửa", edit_classroom_path(@classroom) %>
|
<%= link_to "🗑️ Xóa lớp", @classroom,
    data: { turbo_method: :delete,
            turbo_confirm: "Xóa lớp #{@classroom.name}? Sinh viên sẽ không bị xóa." } %>
|
<%= link_to "⬅️ Quay lại danh sách", classrooms_path %>
