<% content_for :page_title, "Lớp học" %>
<% content_for :breadcrumb do %>
  <li class="breadcrumb-item active">Danh sách lớp học</li>
<% end %>

<div class="card card-success card-outline">
  <div class="card-header">
    <h3 class="card-title">
      <i class="fas fa-chalkboard mr-2"></i>
      Danh sách lớp học
      <span class="badge badge-success ml-2"><%= @classrooms.size %></span>
    </h3>
    <div class="card-tools">
      <%= link_to new_classroom_path, class: "btn btn-success btn-sm" do %>
        <i class="fas fa-plus mr-1"></i> Thêm lớp học
      <% end %>
    </div>
  </div>

  <div class="card-body p-0">
    <% if @classrooms.empty? %>
      <div class="p-4 text-center text-muted">
        <i class="fas fa-inbox fa-3x mb-3"></i>
        <p>Chưa có lớp học nào.</p>
      </div>
    <% else %>
      <table class="table table-hover table-striped mb-0">
        <thead class="thead-light">
          <tr>
            <th>Tên lớp</th>
            <th>Năm học</th>
            <th class="text-center">Số sinh viên</th>
            <th>Mô tả</th>
            <th class="text-center">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% @classrooms.each do |classroom| %>
            <tr>
              <td><strong><%= classroom.name %></strong></td>
              <td><span class="badge badge-secondary"><%= classroom.academic_year %></span></td>
              <td class="text-center">
                <span class="badge badge-info"><%= classroom.students_count %></span>
              </td>
              <td><small class="text-muted"><%= classroom.description || "—" %></small></td>
              <td class="text-center">
                <%= link_to classroom, class: "btn btn-xs btn-info mr-1" do %>
                  <i class="fas fa-eye"></i>
                <% end %>
                <%= link_to edit_classroom_path(classroom), class: "btn btn-xs btn-warning mr-1" do %>
                  <i class="fas fa-edit"></i>
                <% end %>
                <%= link_to classroom,
                            data: { turbo_method: :delete,
                                    turbo_confirm: "Xóa lớp #{classroom.name}?" },
                            class: "btn btn-xs btn-danger" do %>
                  <i class="fas fa-trash"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
