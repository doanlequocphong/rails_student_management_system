<!DOCTYPE html>
<html>
  <head>
    <title>Student Management System</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# Navbar chung cho toàn app %>
    <nav>
      <%= link_to "🏠 Trang chủ", root_path %> |
      <%= link_to "👥 Sinh viên", students_path %> |
      <%= link_to "🏫 Lớp học", classrooms_path %> |
      <%= link_to "📚 Môn học", courses_path %>
    </nav>

    <hr>

    <%# Flash messages — tự mất sau 1 request %>
    <% if notice %>
      <p style="color: green;"><strong><%= notice %></strong></p>
    <% end %>
    <% if alert %>
      <p style="color: red;"><strong><%= alert %></strong></p>
    <% end %>

    <%# Nội dung của từng view được nhúng vào đây %>
    <%= yield %>
  </body>
</html>
