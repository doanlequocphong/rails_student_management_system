<%# ── AdminLTE Top Navbar ─────────────────────────────────────── %>
<nav class="main-header navbar navbar-expand navbar-white navbar-light">

  <%# Left: toggle sidebar button %>
  <ul class="navbar-nav">
    <li class="nav-item">
      <a class="nav-link" data-widget="pushmenu" href="#" role="button">
        <i class="fas fa-bars"></i>
      </a>
    </li>
    <li class="nav-item d-none d-sm-inline-block">
      <%= link_to "Trang chủ", root_path, class: "nav-link" %>
    </li>
  </ul>

  <%# Right: user info + logout %>
  <ul class="navbar-nav ml-auto">
    <% if user_signed_in? %>
      <li class="nav-item dropdown">
        <a class="nav-link" data-toggle="dropdown" href="#">
          <i class="fas fa-user-circle"></i>
          <span class="ml-1"><%= current_user.email %></span>
          <span class="badge badge-secondary ml-1"><%= current_user.display_role %></span>
        </a>
        <div class="dropdown-menu dropdown-menu-right">
          <a class="dropdown-item" href="#">
            <i class="fas fa-user mr-2"></i> Tài khoản
          </a>
          <div class="dropdown-divider"></div>
          <%= link_to destroy_user_session_path,
                      data: { turbo_method: :delete },
                      class: "dropdown-item" do %>
            <i class="fas fa-sign-out-alt mr-2"></i> Đăng xuất
          <% end %>
        </div>
      </li>
    <% else %>
      <li class="nav-item">
        <%= link_to "Đăng nhập", new_user_session_path, class: "nav-link" %>
      </li>
    <% end %>
  </ul>
</nav>
