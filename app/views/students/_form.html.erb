<%# Partial dùng chung cho new và edit %>
<%# Biến "student" được truyền từ new.html.erb và edit.html.erb %>

<%# Hiển thị lỗi validation nếu có %>
<% if student.errors.any? %>
  <div style="border: 1px solid red; padding: 10px; margin-bottom: 10px;">
    <h4><%= pluralize(student.errors.count, "lỗi") %> cần sửa:</h4>
    <ul>
      <% student.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# form_with tự biết POST (new) hay PATCH (edit) dựa vào model %>
<%= form_with model: student do |form| %>

  <div>
    <%= form.label :name, "Họ tên *" %>
    <%= form.text_field :name, placeholder: "Nguyễn Văn A" %>
  </div>

  <div>
    <%= form.label :email, "Email *" %>
    <%= form.email_field :email, placeholder: "example@email.com" %>
  </div>

  <div>
    <%= form.label :phone, "Điện thoại" %>
    <%= form.telephone_field :phone, placeholder: "0901234567" %>
  </div>

  <div>
    <%= form.label :date_of_birth, "Ngày sinh" %>
    <%= form.date_field :date_of_birth %>
  </div>

  <div>
    <%= form.label :address, "Địa chỉ" %>
    <%= form.text_area :address, rows: 3, placeholder: "Số nhà, đường, quận, thành phố" %>
  </div>

  <div>
    <%= form.submit student.new_record? ? "Tạo sinh viên" : "Cập nhật sinh viên" %>
    <%= link_to "Hủy", students_path %>
  </div>

<% end %>
