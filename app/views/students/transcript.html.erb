<h1>Bảng điểm sinh viên</h1>

<%# ── Thông tin sinh viên ────────────────────────────────────────── %>
<table cellpadding="6">
  <tr>
    <td><strong>Họ tên:</strong></td>
    <td><%= @presenter.student.name %></td>
    <td width="40"></td>
    <td><strong>Lớp:</strong></td>
    <td><%= @presenter.student.classroom&.name || "(chưa xếp lớp)" %></td>
  </tr>
  <tr>
    <td><strong>Email:</strong></td>
    <td><%= @presenter.student.email %></td>
    <td></td>
    <td><strong>Ngày sinh:</strong></td>
    <td><%= @presenter.student.date_of_birth&.strftime("%d/%m/%Y") || "—" %></td>
  </tr>
</table>

<hr>

<%# ── Bảng điểm chi tiết ────────────────────────────────────────── %>
<h2>Kết quả học tập</h2>

<% if @presenter.course_rows.empty? %>
  <p><em>Sinh viên chưa có điểm môn học nào.</em></p>
<% else %>
  <table border="1" cellpadding="8">
    <thead>
      <tr>
        <th>Mã môn</th>
        <th>Tên môn học</th>
        <th>Tín chỉ</th>
        <th>Điểm thành phần</th>
        <th>Trung bình</th>
        <th>Xếp loại</th>
        <th>Kết quả</th>
      </tr>
    </thead>
    <tbody>
      <% @presenter.course_rows.each do |row| %>
        <tr class="<%= row[:row_class] %>">
          <td><strong><%= row[:course].code %></strong></td>
          <td><%= link_to row[:course].name, row[:course] %></td>
          <td style="text-align:center"><%= row[:course].credits || "—" %></td>
          <td>
            <% row[:grades].each do |g| %>
              <small><%= g.grade_type %>: <strong><%= g.score %></strong></small><br>
            <% end %>
          </td>
          <td style="text-align:center"><strong><%= row[:average] %></strong></td>
          <td style="text-align:center"><strong><%= row[:letter_grade] %></strong></td>
          <td style="text-align:center">
            <span class="badge badge-<%= row[:status] == :passed ? 'success' : 'danger' %>">
              <%= row[:status_label] %>
            </span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%# ── Tổng kết ─────────────────────────────────────────────────── %>
  <h3>Tổng kết</h3>

  <table cellpadding="6" border="1">
    <tr>
      <td>Tổng tín chỉ đăng ký:</td>
      <td><strong><%= @presenter.total_credits %></strong></td>
    </tr>
    <tr>
      <td>Tổng tín chỉ đạt:</td>
      <td><strong style="color:green"><%= @presenter.earned_credits %></strong></td>
    </tr>
    <tr style="background:#fffbe6;">
      <td><strong>GPA (có trọng số):</strong></td>
      <td>
        <strong style="font-size:1.2em; color:#2c3e50;"><%= @presenter.gpa %></strong>
        <small>/100</small>
        &nbsp;|&nbsp;
        <strong style="color:#2980b9;"><%= @presenter.gpa_4 %></strong>
        <small>/4.0</small>
      </td>
    </tr>
    <tr style="background:#fffbe6;">
      <td><strong>Học lực:</strong></td>
      <td>
        <span class="badge <%= @presenter.standing_badge_class %>">
          <%= @presenter.standing %>
        </span>
      </td>
    </tr>
  </table>
<% end %>

<br>
<%= link_to "⬅️ Quay lại trang sinh viên", @presenter.student %>
|
<%= link_to "👥 Danh sách sinh viên", students_path %>
