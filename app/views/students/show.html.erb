<h1>Thông tin Sinh viên</h1>

<dl>
  <dt>ID:</dt>
  <dd><%= @student.id %></dd>

  <dt>Họ tên:</dt>
  <dd><%= @student.name %></dd>

  <dt>Email:</dt>
  <dd><%= @student.email %></dd>

  <dt>Điện thoại:</dt>
  <dd><%= @student.phone.presence || "(chưa có)" %></dd>

  <dt>Ngày sinh:</dt>
  <dd><%= @student.date_of_birth&.strftime("%d/%m/%Y") || "(chưa có)" %></dd>

  <dt>Địa chỉ:</dt>
  <dd><%= @student.address.presence || "(chưa có)" %></dd>

  <dt>Ngày tạo:</dt>
  <dd><%= @student.created_at.strftime("%d/%m/%Y %H:%M") %></dd>
</dl>

<%= link_to "✏️ Chỉnh sửa", edit_student_path(@student) %>
|
<%= link_to "🗑️ Xóa", @student,
    data: { turbo_method: :delete,
            turbo_confirm: "Xóa sinh viên #{@student.name}?" } %>
|
<%= link_to "⬅️ Quay lại danh sách", students_path %>
