<h1>Thông tin Sinh viên</h1>

<dl>
  <dt>ID:</dt>
  <dd><%= @student.id %></dd>

  <dt>Họ tên:</dt>
  <dd><%= @student.name %></dd>

  <dt>Email:</dt>
  <dd><%= @student.email %></dd>

  <dt>Điện thoại:</dt>
  <dd><%= @student.phone.presence || "(chưa có)" %></dd>

  <dt>Ngày sinh:</dt>
  <dd><%= @student.date_of_birth&.strftime("%d/%m/%Y") || "(chưa có)" %></dd>

  <dt>Lớp học:</dt>
  <dd>
    <% if @student.classroom %>
      <%= link_to @student.classroom.name, @student.classroom %>
    <% else %>
      <em>(chưa xếp lớp)</em>
    <% end %>
  </dd>

  <dt>Địa chỉ:</dt>
  <dd><%= @student.address.presence || "(chưa có)" %></dd>

  <dt>Ngày tạo:</dt>
  <dd><%= @student.created_at.strftime("%d/%m/%Y %H:%M") %></dd>
</dl>

<hr>

<%# ── Phần Môn học đăng ký ─────────────────────────────────────── %>
<h2>Môn học đã đăng ký (<%= @enrollments.count %>)</h2>

<% if @enrollments.empty? %>
  <p><em>Chưa đăng ký môn học nào.</em></p>
<% else %>
  <table border="1" cellpadding="8">
    <thead>
      <tr>
        <th>Mã môn</th>
        <th>Tên môn</th>
        <th>Ngày đăng ký</th>
        <th>Thao tác</th>
      </tr>
    </thead>
    <tbody>
      <% @enrollments.each do |enrollment| %>
        <tr>
          <td><%= enrollment.course.code %></td>
          <td><%= enrollment.course.name %></td>
          <td><%= enrollment.enrolled_at&.strftime("%d/%m/%Y") %></td>
          <td>
            <%= link_to "Hủy đăng ký",
                student_enrollment_path(@student, enrollment),
                data: { turbo_method: :delete,
                        turbo_confirm: "Hủy đăng ký môn #{enrollment.course.name}?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<hr>

<%# ── Form đăng ký môn mới ────────────────────────────────────────── %>
<h3>Đăng ký môn học mới</h3>

<% if @available_courses.empty? %>
  <p><em>Đã đăng ký tất cả môn học hoặc chưa có môn học nào.</em></p>
<% else %>
  <%= form_with url: student_enrollments_path(@student), method: :post do |form| %>
    <%= form.select :course_id,
          @available_courses.map { |c| ["#{c.code} — #{c.name}", c.id] },
          { include_blank: "-- Chọn môn học --" } %>
    <%= form.submit "Đăng ký" %>
  <% end %>
<% end %>

<br>
<%= link_to "📋 Bảng điểm", transcript_student_path(@student) %>
|
<%= link_to "✏️ Chỉnh sửa", edit_student_path(@student) %>
|
<%= link_to "🗑️ Xóa", @student,
    data: { turbo_method: :delete,
            turbo_confirm: "Xóa sinh viên #{@student.name}?" } %>
|
<%= link_to "⬅️ Quay lại danh sách", students_path %>
