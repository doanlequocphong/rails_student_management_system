<h1>Danh sách Sinh viên</h1>

<%= link_to "➕ Thêm sinh viên mới", new_student_path %>

<% if @students.empty? %>
  <p>Chưa có sinh viên nào.</p>
<% else %>
  <table border="1" cellpadding="8">
    <thead>
      <tr>
        <th>ID</th>
        <th>Họ tên</th>
        <th>Email</th>
        <th>Lớp</th>
        <th>Điện thoại</th>
        <th>Ngày sinh</th>
        <th>Thao tác</th>
      </tr>
    </thead>
    <tbody>
      <% @students.each do |student| %>
        <tr>
          <td><%= student.id %></td>
          <td><%= student.name %></td>
          <td><%= student.email %></td>
          <td><%= student.classroom&.name || "—" %></td>
          <td><%= student.phone %></td>
          <td><%= student.date_of_birth&.strftime("%d/%m/%Y") %></td>
          <td>
            <%= link_to "Xem", student %>
            |
            <%= link_to "Sửa", edit_student_path(student) %>
            |
            <%= link_to "Xóa", student,
                data: { turbo_method: :delete,
                        turbo_confirm: "Bạn có chắc muốn xóa #{student.name}?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<p>Tổng cộng: <strong><%= @students.count %></strong> sinh viên</p>
