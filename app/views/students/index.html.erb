<% content_for :page_title, "Sinh viên" %>
<% content_for :breadcrumb do %>
  <li class="breadcrumb-item active">Danh sách sinh viên</li>
<% end %>

<div class="card card-primary card-outline">
  <div class="card-header">
    <h3 class="card-title">
      <i class="fas fa-user-graduate mr-2"></i>
      Danh sách sinh viên
      <span class="badge badge-primary ml-2"><%= @students.count %></span>
    </h3>
    <div class="card-tools">
      <%= link_to new_student_path, class: "btn btn-primary btn-sm" do %>
        <i class="fas fa-plus mr-1"></i> Thêm sinh viên
      <% end %>
    </div>
  </div>

  <div class="card-body p-0">
    <% if @students.empty? %>
      <div class="p-4 text-center text-muted">
        <i class="fas fa-inbox fa-3x mb-3"></i>
        <p>Chưa có sinh viên nào.</p>
      </div>
    <% else %>
      <table class="table table-hover table-striped mb-0">
        <thead class="thead-light">
          <tr>
            <th>ID</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Lớp</th>
            <th>Điện thoại</th>
            <th>Ngày sinh</th>
            <th class="text-center">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% @students.each do |student| %>
            <tr>
              <td><span class="badge badge-secondary"><%= student.id %></span></td>
              <td><strong><%= student.name %></strong></td>
              <td><small><%= student.email %></small></td>
              <td>
                <% if student.classroom %>
                  <span class="badge badge-info"><%= student.classroom.name %></span>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td><%= student.phone || "—" %></td>
              <td><%= student.date_of_birth&.strftime("%d/%m/%Y") || "—" %></td>
              <td class="text-center">
                <%= link_to student, class: "btn btn-xs btn-info mr-1",
                            title: "Xem chi tiết" do %>
                  <i class="fas fa-eye"></i>
                <% end %>
                <%= link_to edit_student_path(student), class: "btn btn-xs btn-warning mr-1",
                            title: "Chỉnh sửa" do %>
                  <i class="fas fa-edit"></i>
                <% end %>
                <%= link_to student,
                            data: { turbo_method: :delete,
                                    turbo_confirm: "Xóa #{student.name}?" },
                            class: "btn btn-xs btn-danger",
                            title: "Xóa" do %>
                  <i class="fas fa-trash"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
